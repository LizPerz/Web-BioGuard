# BioGuard · Configuración de npm
# Auditoría de seguridad siempre activa.
audit=true
# Silencia el banner de "funding" (menos ruido).
fund=false
# Falla la instalación si el Node no cumple con "engines".
engine-strict=true
# Evita sobrescribir package.json por accidente al instalar paquetes.
save=false
