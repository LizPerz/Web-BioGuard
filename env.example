# BioGuard API - Environment Variables
# Copy this file to .env or use dotnet user-secrets
# NEVER commit real secrets to git

# Base de datos
MONGODB_CONNECTION_STRING=mongodb+srv://...

# JWT
JWT_SECRET_KEY=your-jwt-secret-key

# SMTP para envio de correos (Gmail)
# Generar app password: Gmail -> Security -> 2FA -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Stripe (modo test - sk_test_...)
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (generado por Stripe CLI o el dashboard)
# Local: stripe listen -> imprime whsec_...
# Prod:  Stripe dashboard -> Webhooks -> Add endpoint -> signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# URL del frontend (para redirect de Stripe)
# Local: http://localhost:5173
# Prod:  https://bioguard.app
FRONTEND_URL=http://localhost:5173