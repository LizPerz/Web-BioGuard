# BioGuard API - Environment Variables (Backend)
# Copia este archivo a .env o usa `dotnet user-secrets` y llena tus valores
# NUNCA subas secretos reales a git

# Base de datos (obtener en MongoDB Atlas)
MONGODB_CONNECTION_STRING=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>

# JWT (genera una clave aleatoria segura)
JWT_SECRET_KEY=<tu-jwt-secret-key>

# SMTP para envio de correos (Gmail)
# Generar app password: Gmail > Security > 2FA > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<tu-correo@gmail.com>
SMTP_PASS=<tu-app-password>

# Stripe (modo test: sk_test_... / modo live: sk_live_...)
# Obtener en: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook secret (generado por Stripe CLI o el dashboard de Stripe)
# Local: ejecutar `stripe listen` -> imprime whsec_...
# Prod:  Stripe dashboard > Webhooks > Add endpoint > signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# URL del frontend (para redireccionar despues del pago en Stripe)
# Local: http://localhost:5173
# Prod:  https://bioguard.app
FRONTEND_URL=http://localhost:5173